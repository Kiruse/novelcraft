      "get": {
        "tags": [
          "inspirations"
        ],
        "summary": "All inspirations, optionally filtered by tags",
        "description": "Returns every inspiration sorted by title; with `tags`, only those tagged with **all** of the comma-separated tags.",
        "operationId": "listInspirations",
        "parameters": [
          {
            "in": "query",
            "name": "tags",
            "description": "Comma-separated tags; an inspiration must carry **all** of them.",
            "schema": {
              "description": "Comma-separated tags; an inspiration must carry **all** of them.",
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Inspiration"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/inspirations/tags": {
      "get": {
        "tags": [
          "inspirations"
        ],
