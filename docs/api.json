    "/chat/completions": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Create a chat completion (OpenAI-compatible proxy)",
        "description": "Proxies to OpenRouter and settles the cost in quills: 1.00 quill is held before generation, the hold converts into the actual usage cost plus a 50% margin once OpenRouter reports it, and the difference is refunded. Requires a balance of at least 1.00 quills; the balance may go slightly negative by design. Pass `stream: true` for an SSE passthrough. Set the `X-Chat-Session` header to accumulate an agent loop's rounds into a single ledger record.",
        "operationId": "chatCompletions",
        "requestBody": {
          "description": "The curated subset of the OpenAI chat request we accept. Unknown fields\n are ignored (serde default) — compatibility stays loose on read, tight\n on forward.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": true
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAiErrorBody"
                }
              }
            }
          },
          "402": {
            "description": "",
            "content": {
              "application/json": {
