    "/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Stream the account's events over SSE",
        "description": "A server-sent event stream of the account's events; only the authenticated user's events are delivered. Today the only event is `quills` — the balance changed — with the new balance as the `data` payload (rounded to 2 decimals, like every other balance response). Delivery is best-effort: reconnecting clients should re-fetch the balance, and since every event carries full state, a missed event self-heals on the next one.",
        "operationId": "eventsStream",
        "responses": {
          "200": {
            "description": "The event stream — see the operation description.",
            "content": {
              "text/event-stream": {}
            }
          },
          "401": {
            "description": "The uniform error shape of every non-2xx response:\n `{\"error\": \"<safe public message>\"}`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Access token from /auth/register or /auth/login"
      }
    },
    "schemas": {
      "Accepted": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "BalanceResponse": {
        "type": "object",
        "properties": {
          "quills": {
            "description": "Current balance, rounded to 2 decimals.",
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "quills"
        ]
      },
      "ChatCompletionRequest": {
        "description": "The curated subset of the OpenAI chat request we accept. Unknown fields\n are ignored (serde default) — compatibility stays loose on read, tight\n on forward.",
        "type": "object",
        "properties": {
          "max_completion_tokens": {
            "description": "Upper limit on generated output + reasoning tokens. Support depends on\n model & host.",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "max_tokens": {
            "description": "@deprecated in favor of `max_completion_tokens`",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "model": {
            "type": "string"
          },
          "stream": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "top_p": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "required": [
          "model",
          "messages"
        ]
      },
      "ChatFunctionCall": {
        "type": "object",
        "properties": {
          "arguments": {
            "description": "JSON-encoded arguments to this function call",
            "type": "string"
          },
          "name": {
            "description": "Name of the called function",
            "type": "string"
          }
        },
        "required": [
          "name",
          "arguments"
        ]
      },
      "ChatMessage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "tool_calls": {
            "description": "Only ever present on \"assistant\" roles. The tool calls the assistant made in this choice.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ChatToolCall"
            }
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "ChatToolCall": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Type of tool call. Really only ever `function`.",
            "type": "string"
          },
          "function": {
            "$ref": "#/components/schemas/ChatFunctionCall"
          },
          "id": {
            "description": "ID of this tool call, for serving tool call results back to the agent.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "function"
        ]
      },
      "ErrorBody": {
        "description": "The uniform error shape of every non-2xx response:\n `{\"error\": \"<safe public message>\"}`.",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "HistoryQuery": {
        "type": "object",
        "properties": {
          "from_id": {
            "description": "First row of the page (keyset anchor): the returned entries start at\n exactly this id and walk backwards. Absent = newest entries first.",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "HistoryResponse": {
        "type": "object",
        "properties": {
          "has_more": {
            "description": "Older entries exist beyond the page; its anchor is the last id in\n `result`.",
            "type": "boolean"
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuillHistoryResponse"
            }
          }
        },
        "required": [
          "result",
          "has_more"
        ]
      },
      "Inspiration": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "creative_direction": {
            "type": [
              "string",
              "null"
            ]
          },
          "premise": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "premise",
          "tags"
        ]
      },
      "InspirationsQuery": {
        "type": "object",
        "properties": {
          "tags": {
            "description": "Comma-separated tags; an inspiration must carry **all** of them.",
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ModelEntry": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "owned_by": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "owned_by"
        ]
      },
      "ModelsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelEntry"
            }
          },
          "object": {
            "type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ]
      },
      "OpenAiError": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message"
        ]
      },
      "OpenAiErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/OpenAiError"
          }
        },
        "required": [
          "error"
        ]
      },
      "QuillHistoryResponse": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string"
          },
          "tag": {
            "description": "Groups multi-round chat requests into one accumulating record.",
            "type": [
              "string",
              "null"
            ]
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "user_id",
          "amount",
          "kind",
          "created_at"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "invite_code": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "invite_code"
        ]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "new_password": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "new_password"
        ]
      },
      "SaveMeta": {
        "description": "Metadata of one occupied save slot — everything a sync client needs to\n decide which side is newer; the blobs themselves are opaque.",
        "type": "object",
        "properties": {
          "size_bytes": {
            "description": "Blob size in bytes (at most 50 MiB).",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "slot": {
            "description": "The slot number, 1-3.",
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          },
          "updated_at": {
            "description": "When the server last wrote this slot.",
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "slot",
          "size_bytes",
          "updated_at"
        ]
      },
      "SavesResponse": {
        "type": "object",
        "properties": {
          "saves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaveMeta"
            }
          }
        },
        "required": [
          "saves"
        ]
      },
      "SetUsernameRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quills": {
            "description": "Balance in quills, rounded to 2 decimals — internal units come off the row.",
            "type": "number",
            "format": "double"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "quills"
        ]
      }
    }
  }
}
