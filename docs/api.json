    "/quills/history": {
      "get": {
        "tags": [
          "quills"
        ],
        "summary": "The earn/spend ledger, newest first",
        "description": "Stateless keyset pagination: `from_id` anchors the page at the entry with exactly that id, so pages never shift when new entries arrive; the next page is anchored at the last id in `result` while `has_more` is true.",
        "operationId": "quillsHistory",
        "parameters": [
          {
            "in": "query",
            "name": "from_id",
            "description": "First row of the page (keyset anchor): the returned entries start at\n exactly this id and walk backwards. Absent = newest entries first.",
            "schema": {
              "description": "First row of the page (keyset anchor): the returned entries start at\n exactly this id and walk backwards. Absent = newest entries first.",
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "style": "form"
