                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The uniform error shape of every non-2xx response:\n `{\"error\": \"<safe public message>\"}`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "saves"
        ],
        "summary": "Delete a save",
        "description": "Releases the slot. Idempotent: an empty slot answers 204 as well.",
        "operationId": "savesDelete",
        "responses": {
          "204": {
            "description": "no content"
          },
          "401": {
            "description": "The uniform error shape of every non-2xx response:\n `{\"error\": \"<safe public message>\"}`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "The uniform error shape of every non-2xx response:\n `{\"error\": \"<safe public message>\"}`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The uniform error shape of every non-2xx response:\n `{\"error\": \"<safe public message>\"}`.",
            "content": {
