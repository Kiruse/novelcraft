{
  "$schema": "https://schema.tauri.app/config/2.10.3",
  "productName": "NovelCraft",
  "version": "0.1.0",
  "identifier": "quest.novelcraft.app",
  "build": {
    "frontendDist": "gui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd gui && bun run dev",
    "beforeBuildCommand": "cd gui && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "NovelCraft",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:novelcraft.db"]
    }
  }
}
