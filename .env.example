# Required — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL where the app is reachable (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# Database (Neon)
DATABASE_URL=

# GitHub PAT for private @stegakir packages (read:packages scope)
GITHUB_TOKEN=

# Comma-separated registration codes for author signup
AUTHOR_REGISTRATION_CODES=

# SMTP (Mailpit — run ./scripts/run-mail.sh)
SMTP_HOST=localhost
SMTP_PORT=10025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

PROD=false

# Feature flags
ENABLE_STORY_BUILDER=true
